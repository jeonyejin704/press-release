{
  "name": "PressFlow",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "PressFlow",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install && cp -n .env.example .env && npm run setup && chmod +x .devcontainer/start.sh",
  "postAttachCommand": {
    "dev-server": "bash .devcontainer/start.sh"
  },
  "customizations": {
    "vscode": {
      "extensions": ["Prisma.prisma"]
    }
  }
}
