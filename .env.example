# ---------------------------------------------------------------------------
# PressFlow environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Database -------------------------------------------------------------------
# SQLite (zero-config, file based). Works out of the box for local dev and
# GitHub Codespaces — no external database needed.
DATABASE_URL="file:./dev.db"

# Session --------------------------------------------------------------------
# Secret used to sign the (demo) session cookie.
SESSION_SECRET="change-me-in-production"

# AI Provider ----------------------------------------------------------------
# Which AI provider generates press-release drafts.
#   mock       -> deterministic local generator (no network, default)
#   anthropic  -> Anthropic Claude API (requires ANTHROPIC_API_KEY)
#   openai     -> OpenAI API (requires OPENAI_API_KEY) [TODO: implement]
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# News Provider --------------------------------------------------------------
# Which news source powers the monitoring dashboard.
#   mock  -> local sample articles (default)
#   naver -> NAVER Cloud Platform · API HUB "NAVER 검색(뉴스)" API
#
# 실제 기사를 수집하려면:
#   1) NEWS_PROVIDER 를 "naver" 로 변경
#   2) API HUB 애플리케이션 > [인증 정보] 에서 확인한 값을 아래에 입력
#      (Client ID = X-NCP-APIGW-API-KEY-ID, Client Secret = X-NCP-APIGW-API-KEY)
NEWS_PROVIDER="mock"
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
# (선택) 엔드포인트를 직접 지정해야 할 때만 사용. 기본값:
# NAVER_SEARCH_URL="https://naverapihub.apigw.ntruss.com/search/v1/news"

# Email / Notifications (optional) -------------------------------------------
# In-app notifications always work. Email is an optional adapter.
#   none  -> in-app only (default)
#   smtp  -> SMTP transport [TODO]
#   graph -> Microsoft Graph / Outlook [TODO]
NOTIFICATION_EMAIL_PROVIDER="none"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
OUTLOOK_GRAPH_CLIENT_ID=""
OUTLOOK_GRAPH_CLIENT_SECRET=""
OUTLOOK_GRAPH_TENANT_ID=""
